model_name: TMDM
trainer_name: CSDI_trainer
config_path: 'conf/baseline/GoogleCluster_time_machine/TMDM.yaml'
root: './'
seed: 2024 # 随机数种子
target_dim: 100
# training
training_config:
  seed: 2024 # 随机数种子
  des: 'test' # help='exp description'
  device: "cuda:2" # 训练或推理使用的GPU
  is_training: true # 'pred'还是'train'
  model_name: TMDM
  data: 'SURF_Dataset'
  # data_path: './datasets/ETTm1/data.pkl'
  features: M
  freq: 'h'
  checkpoints: './result/TMDM/'

  #task
  # 此处暂未区分前向模型和后向模型的参数配置区别
  task_name: 'long_term_forecast'
  model_id: 'TMDM_96_96'

  #
  enc_in: 100
  dec_in: 100
  c_out: 100
  d_model: 128
  e_layers: 2
  d_layers: 1
  d_ff: 256
  moving_avg: 25
  factor: 3
  n_heads: 8
  distil: True
  label_len: 30
  #forecasting task

  inverse: True
  seasonal_patterns: 'Monthly' #help='subset for M4

  #optimization
  num_workers: 4
  itr: 1
  train_epochs: 200
  batch_size: 256 # help='batch size of train input data'
  patience: 10 #help='early stopping patience'
  learning_rate: 0.001
  loss: 'MSE' #loss function
  lradj: 'type1' #help='adjust learning rate'
  use_amp: False #help='use automatic mixed precision training', default=False
  test_batch_size: 1
  learning_rate_Cond: 0.0001

  # de-stationary projector params
  p_hidden_dims: [64,64] #help='hidden layer dimensions of projector (List)')
  p_hidden_layers: 2

  # metrics (dtw)
  use_dtw: False #help='the controller of using dtw metric (dtw is time consuming, not suggested unless necessary)'

  k_z: 0.01
  k_cond: 1
  d_z: 8

  save_path: './experiments/tmdm/'

  #扩散模型配置
  diffusion_config_dir: './conf/baseline/GoogleCluster_time_machine/TMDM.yaml'

# data
data_config:
  is_non_stationary: False # 决定是否要进行非平稳时间序列的训练，1的话则进行归一化
  dataset_name: SURF_Dataset
  data_path: ./data/GoogleCluster/cpus_avg_100machines_5min.parquet # 数据所在位置
  columns: ['all'] # 确定取数据中哪些列及其相对位置
  target_cols: ['all'] # 目标列名
  feature_cols_da: [] # 辅助变量，日前
  feature_cols_mask2D: [] # 辅助变量，日内
  feature_cols_mask1D: [] # 辅助变量，日内
  data_mode: 2 # 0的话就是使用数据长度切割数据，1的话就是使用时间切割数据
  unit_len: 1 # 一天的数据序列长度
  training_step: 1 # 训练时偏移的步长
  past_len: 60 # 历史窗长，多少个unit_len
  pred_len: 6 # 预测长度，多少个unit_len
  data_len: # data_mode为0
    end: "2019-06-01 00:10:00"
    train: 366
    valid: 32
    test: 62
    shift: 0
  data_time: # data_mode为1
    train: # 训练集
      start: "2019-05-01 00:05:00"
      end: "2019-05-22 00:05:00"
    valid: # 验证集
      start: "2019-05-22 00:10:00"
      end: "2019-05-25 00:10:00"
    test: # 测试集
      start: "2019-05-25 00:15:00"
      end: "2019-06-01 00:10:00"
  train_val_test_ratio: [0.7, 0.1, 0.2] #data_mode为2

# model
model_config:
  real_target_dim: 100
  dropout: 0.05
  embed: 'timeF'
  activation: 'gelu'
  output_attention: False
  channel_independence: 1 #help='0: channel dependence 1: channel independence for FreTS model'
  decomp_method: 'moving_avg' #help='method of series decompsition, only support moving_avg or dft_decomp')
  use_norm: 1 #help='whether to use normalize; True 1 False 0'
  down_sampling_layers: 3   #help='whether to use normalize; True 1 False 0'
  down_sampling_window: 2   #help='num of down sampling layers'
  down_sampling_method: 'avg' #help='down sampling method, only support avg, max, conv'
  seg_len: 66


  #augmentation_ratio
  augmentation_ratio: 0  # How many times to augment
  jitter: false  # Jitter preset augmentation
  scaling: false  # Scaling preset augmentation
  permutation: false  # Equal Length Permutation preset augmentation
  randompermutation: false  # Random Length Permutation preset augmentation
  magwarp: false  # Magnitude warp preset augmentation
  timewarp: false  # Time warp preset augmentation
  windowslice: false  # Window slice preset augmentation
  windowwarp: false  # Window warp preset augmentation
  rotation: false  # Rotation preset augmentation
  spawner: false  # SPAWNER preset augmentation
  dtwwarp: false  # DTW warp preset augmentation
  shapedtwwarp: false  # Shape DTW warp preset augmentation
  wdba: false  # Weighted DBA preset augmentation
  discdtw: false  # Discriminative DTW warp preset augmentation
  discsdtw: false  # Discriminative shape DTW warp preset augmentation
  extra_tag: ""  # Anything extra


  # CART related args
  cond_pred_model_pertrain_dir: ''
  CART_input_x_embed_dim: 32
  mse_timestep: 0
  MLP_diffusion_net: False
  timesteps: 1000


  data:
      dataset: "8gauss"
      true_function: None
      dataset_size: 10240
      seed: 2000
      no_multimodality: False
      inverse_xy: False
      x_dict: {"ct_toy_name": "8gaussians"}
      noise_dict: {}
      train_ratio: 0.8
      num_workers: 0
      normalize_x: False
      normalize_y: False

  model:
      type: "simple"
      data_dim: 2
      x_dim: 1
      y_dim: 1
      z_dim: 2
      cat_x: True
      cat_y_pred: True
      feature_dim: 128
      var_type: fixedlarge
      ema_rate: 0.9999
      ema: True

  diffusion:
      beta_schedule: linear  # cosine_anneal
      beta_start: 0.0001
      beta_end: 0.02
      timesteps: 100
      vis_step: 100
      num_figs: 10
      conditioning_signal: "NN"
      nonlinear_guidance:
          pre_train: True
          joint_train: False
          n_pretrain_epochs: 100
          logging_interval: 10
          hid_layers: [100, 50]
          use_batchnorm: False
          negative_slope: 0.01
          dropout_rate: 0.0
          apply_early_stopping: False
          n_pretrain_max_epochs: 1000
          train_ratio: 0.6
          patience: 50
          delta: 0

  training:
      batch_size: 256
      n_epochs: 5000
      n_iters: 100000
      snapshot_freq: 1000000000
      logging_freq: 1000
      validation_freq: 128000
      image_folder: 'training_image_samples'

  sampling:
      batch_size: 256
      sampling_size: 1000
      last_only: True
      image_folder: 'sampling_image_samples'

  testing:
      batch_size: 256
      sampling_size: 1000
      last_only: True
      plot_freq: 200
      image_folder: 'testing_image_samples'
      n_z_samples: 100
      n_z_samples_depart: 10
      sampling_timesteps: 100
      n_bins: 10

      compute_metric_all_steps: True
      mean_t: 0
      coverage_t: 0
      nll_t: 0
      vis_t: 0
      trimmed_mean_range: [0.0, 100.0]
      PICP_range: [2.5, 97.5]
      make_plot: True
      squared_plot: True
      plot_true: True
      plot_gen: True
      fig_size: [8, 5]
      one_fig_size: [4, 4]

  optim:
      weight_decay: 0.000
      optimizer: "Adam"
      lr: 0.001
      beta1: 0.9
      amsgrad: false
      eps: 0.00000001
      grad_clip: 1.0

  aux_optim:
      weight_decay: 0.000
      optimizer: "Adam"
      lr: 0.001
      beta1: 0.9
      amsgrad: True
      eps: 0.00000001
      grad_clip: 1.0
